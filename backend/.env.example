# Gemini API key (required)
GEMINI_API_KEY=your-gemini-api-key-here

# Gemini model name — set this to the current Gemini Flash model from Google AI Studio
# (e.g. gemini-2.5-flash-preview-04-17). Check https://ai.google.dev for the latest.
GEMINI_MODEL=your-gemini-flash-model-here

# Allowed frontend origin for CORS (required)
FRONTEND_ORIGIN=http://localhost:5173
